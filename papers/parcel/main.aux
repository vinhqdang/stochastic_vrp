\@writefile{lot}{\contentsline {table}{\numberline {2}{\ignorespaces Paired comparisons, $n=120$ receiver-instances ($60$ instances $\times $ $2$ independent sub-questions), matched-budget grid. $\Delta $ is the first policy minus the second, with a $95\%$ paired bootstrap CI; token ratio $>1$ means the first is cheaper. Starred $p<0.05$ (McNemar, exact); see \S  \ref {sec:disc} for a cluster-robust check.}}{6}{table.caption.21}\protected@file@percent }
\newlabel{tab:main}{{2}{6}{Paired comparisons, $n=120$ receiver-instances ($60$ instances $\times $ $2$ independent sub-questions), matched-budget grid. $\Delta $ is the first policy minus the second, with a $95\%$ paired bootstrap CI; token ratio $>1$ means the first is cheaper. Starred $p<0.05$ (McNemar, exact); see \S \ref {sec:disc} for a cluster-robust check}{table.caption.21}{}}
\@writefile{lot}{\contentsline {table}{\numberline {3}{\ignorespaces Accuracy and cost per policy, matched-budget grid, $n=120$. Tokens are per receiver; the ratio is broadcast's mean tokens divided by the policy's, from the two numbers shown. Absolute exact-match is suppressed for deltas since MuSiQue predates current models (\S  \ref {sec:disc}: $0\%$ memorised here, up to $5\%$ on the other model). ``Density'' is \S  \ref {sec:alg}'s exact-dominance heuristic at two thresholds, not Algorithm\nonbreakingspace \ref {alg:dp}, evaluated separately in Table\nonbreakingspace \ref {tab:curves}.}}{6}{table.caption.22}\protected@file@percent }
\newlabel{tab:policies}{{3}{6}{Accuracy and cost per policy, matched-budget grid, $n=120$. Tokens are per receiver; the ratio is broadcast's mean tokens divided by the policy's, from the two numbers shown. Absolute exact-match is suppressed for deltas since MuSiQue predates current models (\S \ref {sec:disc}: $0\%$ memorised here, up to $5\%$ on the other model). ``Density'' is \S \ref {sec:alg}'s exact-dominance heuristic at two thresholds, not Algorithm~\ref {alg:dp}, evaluated separately in Table~\ref {tab:curves}}{table.caption.22}{}}
\@writefile{toc}{\contentsline {paragraph}{The separation appears in the data.}{6}{section*.24}\protected@file@percent }
\@writefile{toc}{\contentsline {paragraph}{A cost--quality frontier, honestly reported.}{6}{section*.26}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {2}{\ignorespaces The measured cost--quality frontier, $n=120$ receiver-instances. The dashed line is broadcast's accuracy; anything above it is both cheaper \emph  {and} better. The oracle sits there, at $21\times $ fewer tokens, which is the order of magnitude the problem makes available. The implementable policies cluster well below the grey envelope, and --- the point of the paper's negative result --- they differ from one another by far less than any of them differs from the oracle. The seed set at matched cost is $39$ points down, and random delivery ($-0.667$) fixes the scale of the task. An empty-allocation arm (not shown, $0$ tokens, $-0.792$) is the contamination control.}}{7}{figure.caption.23}\protected@file@percent }
\newlabel{fig:frontier}{{2}{7}{The measured cost--quality frontier, $n=120$ receiver-instances. The dashed line is broadcast's accuracy; anything above it is both cheaper \emph {and} better. The oracle sits there, at $21\times $ fewer tokens, which is the order of magnitude the problem makes available. The implementable policies cluster well below the grey envelope, and --- the point of the paper's negative result --- they differ from one another by far less than any of them differs from the oracle. The seed set at matched cost is $39$ points down, and random delivery ($-0.667$) fixes the scale of the task. An empty-allocation arm (not shown, $0$ tokens, $-0.792$) is the contamination control}{figure.caption.23}{}}
\@writefile{lot}{\contentsline {table}{\numberline {4}{\ignorespaces Proposition\nonbreakingspace \ref {prop:sep} predicts the seed-set gap grows with the number of receivers. Delivery recall as instances are fused to raise $n$. The seed set collapses; per-receiver allocation does not.}}{7}{table.caption.25}\protected@file@percent }
\newlabel{tab:scaling}{{4}{7}{Proposition~\ref {prop:sep} predicts the seed-set gap grows with the number of receivers. Delivery recall as instances are fused to raise $n$. The seed set collapses; per-receiver allocation does not}{table.caption.25}{}}
\@writefile{toc}{\contentsline {paragraph}{A negative result on algorithm design.}{7}{section*.27}\protected@file@percent }
\@writefile{lot}{\contentsline {table}{\numberline {5}{\ignorespaces Four designs for the value curve $v_i(b)$ that Algorithm\nonbreakingspace \ref {alg:dp} consumes, scored by delivery recall at matched spend against a tuned uniform per-receiver rule, $n=130$ composite instances (SE\nonbreakingspace $\approx \!0.04$ on a recall near $0.6$, comparable to the differences below --- read ``ties'' as \emph  {not detectably different}, not \emph  {proven equal}). The structure Proposition\nonbreakingspace \ref {prop:decomp} exposes is real; on this benchmark it is not \emph  {estimable}.}}{7}{table.caption.28}\protected@file@percent }
\newlabel{tab:curves}{{5}{7}{Four designs for the value curve $v_i(b)$ that Algorithm~\ref {alg:dp} consumes, scored by delivery recall at matched spend against a tuned uniform per-receiver rule, $n=130$ composite instances (SE~$\approx \!0.04$ on a recall near $0.6$, comparable to the differences below --- read ``ties'' as \emph {not detectably different}, not \emph {proven equal}). The structure Proposition~\ref {prop:decomp} exposes is real; on this benchmark it is not \emph {estimable}}{table.caption.28}{}}
\@writefile{lot}{\contentsline {table}{\numberline {6}{\ignorespaces Replacing lexical relevance with a dense embedding scorer \emph  {harms} per-receiver retrieval but helps the seed set. The two signals fail in opposite directions: embeddings capture what an instance is about, lexical matching captures which receiver needs what.}}{7}{table.caption.29}\protected@file@percent }
\newlabel{tab:scorer}{{6}{7}{Replacing lexical relevance with a dense embedding scorer \emph {harms} per-receiver retrieval but helps the seed set. The two signals fail in opposite directions: embeddings capture what an instance is about, lexical matching captures which receiver needs what}{table.caption.29}{}}
