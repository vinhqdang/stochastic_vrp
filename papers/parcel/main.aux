\@writefile{lot}{\contentsline {table}{\numberline {2}{\ignorespaces Paired comparisons, $n=120$ receiver-instances ($60$ instances $\times $ $2$ independent sub-questions), matched-budget grid. $\Delta $ is the first policy minus the second; tokens are each arm's mean, real \texttt  {countTokens} counts on the exact transmitted context, not a word-count proxy (broadcast $2517$; \texttt  {code/real\_tokens.py}). CI and $p$ are the \emph  {primary}, cluster-robust statistics from \texttt  {code/cluster\_test.py}: a block bootstrap and a permutation test resampling the $60$ source instances, not the $120$ receivers, since each instance contributes two non-independent receivers --- the flat, receiver-level McNemar test differs negligibly (largest shift: this $p$ $0.013\to 0.029$) and is not shown. Starred $p<0.05$.}}{7}{table.caption.20}\protected@file@percent }
\newlabel{tab:main}{{2}{7}{Paired comparisons, $n=120$ receiver-instances ($60$ instances $\times $ $2$ independent sub-questions), matched-budget grid. $\Delta $ is the first policy minus the second; tokens are each arm's mean, real \texttt {countTokens} counts on the exact transmitted context, not a word-count proxy (broadcast $2517$; \texttt {code/real\_tokens.py}). CI and $p$ are the \emph {primary}, cluster-robust statistics from \texttt {code/cluster\_test.py}: a block bootstrap and a permutation test resampling the $60$ source instances, not the $120$ receivers, since each instance contributes two non-independent receivers --- the flat, receiver-level McNemar test differs negligibly (largest shift: this $p$ $0.013\to 0.029$) and is not shown. Starred $p<0.05$}{table.caption.20}{}}
\@writefile{lot}{\contentsline {table}{\numberline {3}{\ignorespaces Accuracy and cost per policy, matched-budget grid, $n=120$. Tokens are per receiver, real \texttt  {countTokens} counts (not a word-count proxy); the ratio is broadcast's mean tokens divided by the policy's, from the two numbers shown. Absolute exact-match is suppressed for deltas since MuSiQue predates current models (\S  \ref {sec:disc}: $0\%$ no-context accuracy here, up to $5\%$ on the other model's pilot). ``Density'' is \S  \ref {sec:alg}'s density-greedy heuristic (an approximation of the exact dominance test, \emph  {not} an instance of it) at two thresholds; it is a different policy from Algorithm\nonbreakingspace \ref {alg:dp}, evaluated separately in Table\nonbreakingspace \ref {tab:curves}.}}{7}{table.caption.21}\protected@file@percent }
\newlabel{tab:policies}{{3}{7}{Accuracy and cost per policy, matched-budget grid, $n=120$. Tokens are per receiver, real \texttt {countTokens} counts (not a word-count proxy); the ratio is broadcast's mean tokens divided by the policy's, from the two numbers shown. Absolute exact-match is suppressed for deltas since MuSiQue predates current models (\S \ref {sec:disc}: $0\%$ no-context accuracy here, up to $5\%$ on the other model's pilot). ``Density'' is \S \ref {sec:alg}'s density-greedy heuristic (an approximation of the exact dominance test, \emph {not} an instance of it) at two thresholds; it is a different policy from Algorithm~\ref {alg:dp}, evaluated separately in Table~\ref {tab:curves}}{table.caption.21}{}}
\@writefile{toc}{\contentsline {paragraph}{A negative result on algorithm design.}{7}{section*.25}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {1}{\ignorespaces The measured cost--quality frontier, $n=120$ receiver-instances, real \texttt  {countTokens} counts. Vertical bars are $95\%$ cluster-robust CIs for the three points Table\nonbreakingspace \ref {tab:main} reports against broadcast (oracle, density-loose, uniform $k{=}5$); the other points have no CI reported here. The dashed line is broadcast's accuracy; anything above it is both cheaper \emph  {and} better. None of the three plotted intervals clears zero on the positive side: oracle's and density-loose's both cross the dashed line, and uniform $k{=}5$'s interval excludes zero entirely but on the \emph  {negative} side, i.e.\ is confidently below broadcast, not above it. The implementable policies cluster well below the grey envelope, and --- the point of the paper's negative result --- they differ from one another by far less than any of them differs from the oracle. The seed set at matched cost is $39$ points down, and random delivery ($-0.667$) fixes the scale of the task. An empty-allocation arm (not shown, $0$ tokens, $-0.792$) is the contamination control.}}{7}{figure.caption.22}\protected@file@percent }
\newlabel{fig:frontier}{{1}{7}{The measured cost--quality frontier, $n=120$ receiver-instances, real \texttt {countTokens} counts. Vertical bars are $95\%$ cluster-robust CIs for the three points Table~\ref {tab:main} reports against broadcast (oracle, density-loose, uniform $k{=}5$); the other points have no CI reported here. The dashed line is broadcast's accuracy; anything above it is both cheaper \emph {and} better. None of the three plotted intervals clears zero on the positive side: oracle's and density-loose's both cross the dashed line, and uniform $k{=}5$'s interval excludes zero entirely but on the \emph {negative} side, i.e.\^^Mis confidently below broadcast, not above it. The implementable policies cluster well below the grey envelope, and --- the point of the paper's negative result --- they differ from one another by far less than any of them differs from the oracle. The seed set at matched cost is $39$ points down, and random delivery ($-0.667$) fixes the scale of the task. An empty-allocation arm (not shown, $0$ tokens, $-0.792$) is the contamination control}{figure.caption.22}{}}
\@writefile{lot}{\contentsline {table}{\numberline {4}{\ignorespaces Three designs for $v_i(b)$: $\DOTSI \sumop \slimits@ \mathrm  {raw}$ (sum), $1-\DOTSI \prodop \slimits@ (1-\mathrm  {raw})$ (noisy-OR), $\DOTSI \sumop \slimits@ \mathrm  {raw}/\DOTSI \sumop \slimits@ \mathrm  {raw}$ (captured mass, Algorithm\nonbreakingspace \ref {alg:dp}'s own curve). Scored by delivery recall (deterministic) at matched nominal spend against tuned uniform, on $n=130$ branching instances (plain, $260$ receivers, uniform recall $0.673$) and the same $130$ with a composite receiver added (390 receivers, uniform recall $0.528$). $\Delta $ is curve minus uniform with a 95\% cluster bootstrap CI over instances; tokens are real \texttt  {countTokens} counts (\texttt  {code/value\_curves\_check.py}), freshly computed since the code behind a prior version of this table no longer exists (see STATUS.md).}}{7}{table.caption.26}\protected@file@percent }
\newlabel{tab:curves}{{4}{7}{Three designs for $v_i(b)$: $\sum \mathrm {raw}$ (sum), $1-\prod (1-\mathrm {raw})$ (noisy-OR), $\sum \mathrm {raw}/\sum \mathrm {raw}$ (captured mass, Algorithm~\ref {alg:dp}'s own curve). Scored by delivery recall (deterministic) at matched nominal spend against tuned uniform, on $n=130$ branching instances (plain, $260$ receivers, uniform recall $0.673$) and the same $130$ with a composite receiver added (390 receivers, uniform recall $0.528$). $\Delta $ is curve minus uniform with a 95\% cluster bootstrap CI over instances; tokens are real \texttt {countTokens} counts (\texttt {code/value\_curves\_check.py}), freshly computed since the code behind a prior version of this table no longer exists (see STATUS.md)}{table.caption.26}{}}
